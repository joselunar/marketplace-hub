#--------------------------------------------------------------------
# Marketplace Hub - variáveis de ambiente
#
# Copie para .env e preencha os valores. O .env NUNCA deve ser versionado.
# Use o formato CHAVE=valor (sem espaços ao redor do "="), pois o mesmo
# arquivo é lido pelo CodeIgniter e pelo Docker Compose.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# AMBIENTE
#--------------------------------------------------------------------
CI_ENVIRONMENT=development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL=http://localhost:8080/
app.forceGlobalSecureRequests=false

#--------------------------------------------------------------------
# MYSQL (Docker Compose)
#--------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=marketplace_hub
MYSQL_TEST_DATABASE=marketplace_hub_test
MYSQL_USER=marketplace
MYSQL_PASSWORD=
MYSQL_PORT=3306

#--------------------------------------------------------------------
# BANCO DE DADOS (CodeIgniter)
#--------------------------------------------------------------------
database.default.hostname=127.0.0.1
database.default.database=marketplace_hub
database.default.username=marketplace
database.default.password=
database.default.DBDriver=MySQLi
database.default.port=3306

database.tests.hostname=127.0.0.1
database.tests.database=marketplace_hub_test
database.tests.username=marketplace
database.tests.password=
database.tests.DBDriver=MySQLi
database.tests.DBPrefix=
database.tests.charset=utf8mb4
database.tests.DBCollat=utf8mb4_unicode_ci
database.tests.port=3306

#--------------------------------------------------------------------
# CRIPTOGRAFIA
# Gere com: php spark key:generate
#--------------------------------------------------------------------
encryption.key=

#--------------------------------------------------------------------
# SEEDER DE DESENVOLVIMENTO
# Se a senha ficar vazia, o seeder gera uma senha aleatória e a exibe no terminal.
#--------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@marketplacehub.local
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_EMAIL=operador@marketplacehub.local
SEED_OPERATOR_PASSWORD=

#--------------------------------------------------------------------
# MERCADO LIVRE (Fase 5 - ainda não utilizado)
#--------------------------------------------------------------------
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# logger.threshold=4
